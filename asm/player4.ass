*-----------------------------------------------------
* FIN DE BLOC: 2 octets a lire
*              et 3 a combler (CRC + $FF)
*-----------------------------------------------------
FIN_BLOC
  REPT  6,READ_BIT    lecture donnee son          (36)
  STB   <$CD          joue echantillon             (4)

  REPT  5,READ_BIT    lecture donnee son          (30)
  LSLB                6 bits en tout               (2)
  STB   BUF1          mise en buffer               (5)

  REPT  5,READ_BIT    lecture donnee son          (30)
  LSLB                6 bits en tout               (2)
  STB   BUF2          mise en buffer               (5)

* Lecture CRC a toute vitesse
  REPT  16,GET_BIT    lecture CRC                 (64)

  CMPB  ,X            attente                      (4)
  CMPB  1,X           attente                      (5)
  CMPB  1,X           attente                      (5)
  CMPB  1,X           attente                      (5)
  CMPB  1,X           attente                      (5)

  LDB   #0            lecture buffer 1             (2)
  VAR   BUF1,-1
  STB   <$CD          joue echantillon             (4)
* son a 168 cycles

* Lecture $FF
 
* xx  recupe pile
* ktst
  REPT  8,READ_BIT    lecture octet $FF           (48)
  CMPB  #$FE          $FF pas trouve?              (2)
  BEQ   FIN_SPECIAL   cas particulier              (3)
* 53

* TO8/9 : b0 E7C8 => kpress
* TO7 : clr E7C9 ; lda $E7C8; cmpa #$FF -> carry=ktst
* TO7/70
*   LDD #$6FF   (3)
*LOOP
*   STA  <$E7C9 (4)
*   ANDB <$E7C8 (4)
*   DECA        (2)
*   BPL  LOOP   (3) 13*6+3+2 = 83
*   CMPB #255   (2)
*   RTS
* MO5 A7C0 STA, LDA, BMI
*  6E 40

* On doit attendre 109 cycles pour se caler
* sur le dernier echantillon audio. On pourrait en
* profiter pour tester le clavier (41 cycles TO8/TO9+,
* 25 cycles TO9/TO8proto#14/TO9DE), 32 cycles TO7,
* 181 cycles TO7/70).
  LDB   #21                                        (2)
WAIT1
  DECB                decompte                     (2)
  BNE   WAIT1         pas termine                  (3)
  NOP                                              (2)

  LDB   #0                                         (2)
  VAR   BUF2,-1
  STB   <$CD          joue buffer2                 (4)
* 168

* attente pour se caller juste au debut du prochain bloc
* 168 - 105 = 63 = 3+12*5

  LDD   #$7F00+12                                  (3)
WAIT2
  DECB                                             (2)
  BNE   WAIT2                                      (3)

* bouclage nouveau bloc.
* Prochain son dans 8+4+53+40 = 105
  LEAS  -170*2,S                                   (8)
  JMP   DEB_BLOC                                   (4)

* on a obtenu le $FE sans avoir lu $FF, du coup pas
* DEB_BLOC.
FIN_SPECIAL
* attente 168-53-5-4 = 106 = 2+2+2 + 20*5
  NOP
  NOP
  LDB   #20
WAIT3
  DECB
  BNE   WAIT3

  LDB   BUF2                                       (5)
  STB   <$CD                                       (4)

* attente 168-36-4-8-4 = 116 = 2+2+2 + 22*5
  NOP                                              (2)
  NOP                                              (2)
  LDB   #22                                        (2)
WAIT4
  DECB                                             (2)
  BNE   WAIT4                                      (3)
  LEAS  -170*2,S                                   (8)
  JMP   TRAME                                      (4)

