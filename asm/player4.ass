* Ce programme utilise le controleur et l'interface
* SDDRIVE pour afficher une video en streaming.
* Le chargement et le lancement du programme sont
* realises grace a un secteur de boot.

MODE_MONO   set 0   Memoire forme: N&B
MODE_RGB    set 1   Memoire forme: R/G/B
MODE_BM59   set 2   Memoire forme, palette 4 couls
MODE_PAL    set 3   Memoire fond, palette

MACH_TO7    set 0
MACH_TO770  set 1
MACH_TO9    set 2
MACH_TO8    set 3
MACH_TO9p   set 6

MACH_MO5    set 128+2
MACH_MO6    set 128+3

****************************************************
*                Version 2024.03.11                *
****************************************************
* Historique
* 2024.03.11 marche sur TO ou MO.
* 2024.02.11 168 cycles/ech = 5952.38hz
* 2018.07.14 adresse SD_LB0 calculee selon version
* 2018.07.02 deplacement de la zone SD_LB0 en <$51
* 2018.02.04 ajout du son
* 2018.02.03 debut du developpement

*------------------------------------------------------
* DEBUT DU PROGRAMME
*------------------------------------------------------
  ORG   $9100
START SET *
  LEAS  START,PCR
  BRA   INIT          initialisations

*------------------------------------------------------
* FONCTION D'ACCES A LA CARTE SD
*------------------------------------------------------
CMD18
  FCB   $52           read multiple block
  FDB   $0000         adresse bloc (poids fort)
  FDB   $0000         adresse bloc (poids faible)
  FCB   $FF           checksum non testee
  FCB   $00           code retour attendu
CMD12
  FCB   $4C           stop transmission
  FDB   $0000         dummy parameter
  FDB   $0000         dummy parameter
  FCB   $FF           checksum non testee
  FCB   $00           code retour attendu

*------------------------------------------------------
* MACRO de repetition
*------------------------------------------------------
REPT_MASK SET 0
REPT_MASK SET REPT_MASK+(1<+(2-2))
REPT_MASK SET REPT_MASK+(1<+(3-2))
REPT_MASK SET REPT_MASK+(1<+(4-2))
REPT_MASK SET REPT_MASK+(1<+(5-2))
REPT_MASK SET REPT_MASK+(1<+(6-2))
REPT_MASK SET REPT_MASK+(1<+(7-2))
REPT_MASK SET REPT_MASK+(1<+(8-2))
REPT_MASK SET REPT_MASK+(1<+(16-2))

REPT MACRO
  IFNE REPT_MASK&(1<+((\0)-2))
    REP\0 \1
  ELSE
    REPTn \0,\1
  ENDC
  ENDM
REPTn MACRO
  IFGE (\0)-1
    IFNE (\0)&1
      \1
    ENDC
    REPTn (\0)<-1,\1
    REPTn (\0)<-1,\1
  ENDC
  ENDM
REP16 MACRO
  REP8 \0
  REP8 \0
  ENDM
REP8 MACRO
  REP4 \0
  REP4 \0
  ENDM
REP7 MACRO
  REP6 \0
  \0
  ENDM
REP6 MACRO
  REP4 \0
  REP2 \0
  ENDM
REP5 MACRO
  REP4 \0
  \0
  ENDM
REP4 MACRO
  REP2 \0
  REP2 \0
  ENDM
REP3 MACRO
  REP2 \0
  \0
  ENDM
REP2 MACRO
  \0
  \0
  ENDM

*------------------------------------------------------
* MACRO de variable dans code auto-modifie
*------------------------------------------------------
VAR MACRO
\0 SET *+(\1)
  ENDM

*------------------------------------------------------
* MACRO D'ENVOI D'UN TOP D'HORLOGE
* Le registre A doit contenir $7F avant l'appel
*------------------------------------------------------
GET_BIT MACRO
  CMPA  <$BF          lecture bit 7                 (4)
  ENDM

*------------------------------------------------------
* MACRO DE LECTURE D'UN BIT AVEC SDDRIVE
* Le registre A doit contenir $7F avant l'appel
* Le bit est ajoute a droite de B
*------------------------------------------------------
READ_BIT MACRO
  GET_BIT             lecture bit                   (4)
  ROLB                pousser dans B                (2)
  ENDM

*------------------------------------------------------
* DETECTION DU TYPE D'ORDINATEUR TO OU MO
*------------------------------------------------------
INIT
  ORCC  #$50          desactive les interruptions
  LDB   >$FFF0
  LDA   >$FFF2        $FFF2: $F0(MO) et $70(TO)
  BMI   INIT_MO       MO5/MO6

*------------------------------------------------------
* Initialisations communes TO7/TO8
*------------------------------------------------------
  STB   MACHINE
  
  LDX   #$E7C0        base regs TO
  LDU   #$5F40        fin memoire video+1 ligne

  LDD   #$0240
  STB   PATCH_ECR
  STA   PATCH_POS

  LDD   #$E7C3        Valeur espace I/O
  STA   PATCH_CYC     pour compenser 1 cycle
  STB   TRAME_SWAP_PATCH1
  STB   TRAME_SWAP_PATCH2
  STD   TRAME_FONDFORME_PATCH
  
  STB   <$5F          change le mode gfx pour reset
  CLR   <$D1          force reset basic
  
  BRA   INIT2

*------------------------------------------------------
* Initialisations communes MO5/MO6/PC128
*------------------------------------------------------
INIT_MO
  ADDB  #MACH_MO5
  STB   MACHINE
  
  LDX   #$A7C0        adresse selection banque video
  LDU   #$1F40        fin memoire video+1 ligne

*  LDA   $C000         reset du basic
* $1FDF = $A5 --> restore palette
*  COM   <$5F          change le mode gfx pour reset

*  LDB    #$FF
  STB    $2300        reset basic 128
  CLR    $2200        reset basic 1

*------------------------------------------------------
* Initialisation mode graphique
*------------------------------------------------------
INIT2
  IFEQ  MODE-MODE_BM59
  JSR   ECRAN_BM59
  ENDC
  IFEQ  MODE-MODE_PAL
  JSR   ECRAN_PAL
  ENDC
  IFEQ  MODE-MODE_RGB
  JSR   ECRAN_RGB
  ENDC
  IFEQ  MODE-MODE_MONO
  JSR   ECRAN_MONO
  ENDC

*------------------------------------------------------
* Initialisations communes
*------------------------------------------------------
* Calcul adresse SD_LB0 selon version controleur SDDRIVE
* L'adresse de SD_LB0 passe de $208E-$608E a $2051-$6051
* pour tous les controleurs a partir de juillet 2018
INIT8
  TFR   X,D           $A7xx/$E7xx
  SUBA  #$07          valeur adresse EXCMD (poids fort)
  STA   PATCH_READ    adresse execution EXCMD (pour CMD18)
  STA   PATCH_FIN     adresse execution EXCMD (pour CMD12)

  TFR   DP,A          valeur de DP dans A
  LDB   #$51          adresse de SD_LB0 version recente
  TFR   D,X           stockee dans le registre X
  LDB   <$58          SD_SEL contient $55 depuis 20180702
  CMPB  #$55          test version 20180702 ou plus recente
  BEQ   INIT9         version recente

  LDB   <$57          ; SD_SEL en $6057 b0-b7 depuis 20210212
  ANDB  #$7F          ; isole b0-b6
  CMPB  #$55          ; test version 20210212 ou plus recente
  BEQ   INIT9         ; version 20210212 ou plus recente

  LDB   #$8E          adresse SD_LB0 des versions anciennes
  TFR   D,X           stockage dans le registre X

* Initialisation adresse du fichier .sd pour CMD18
INIT9
  LDD   ,X            octets poids fort adresse
  STD   >CMD18+1      stockage pour commande CMD18
  LDD   2,X           octets poids faible adresse
  STD   >CMD18+3      stockage pour commande CMD18

* Initialisation CNA en sortie
  TFR   DP,B          valeur actuelle de DP
  ADDB  #$87          $A7 pour MO et $E7 pour TO
  TFR   B,DP          initialisation DP
  LDA   <$CF          lecture registre de controle B
  ANDA  #$FB          raz bit 2
  STA   <$CF          selection DDRB
  LDB   #$3F          set bits 0-5
  STB   <$CD          bits CNA en sortie
  ORA   #$04          set b2
  STA   <$CF          selection PB

* Passage progressif du CNA a 0
  LDA   <$CD
  ANDA  #63
  BEQ   INIT12
INIT10
  LDB   #200          1ms
INIT11
  DECB
  BNE  INIT11
  DECA
  STA  <$CD
  BNE  INIT10

* Passage progressif du CNA a 32
*  CLRA
INIT12
  STA   <$CD
  LDB   #200          1ms
INIT13
  DECB
  BNE   INIT13
  INCA
  CMPA  #33
  BNE   INIT12
* BRA   READ_VID

*-------------------------------------------------------
* Lancement de la commande CMD18 et saut de huit blocs
*-------------------------------------------------------
READ_VID
  LDU   #CMD18        adresse commande CMD18
  JSR   $A028         EXCMD = execution commande
  VAR   PATCH_READ,-2
* BCS   READ_VID

  LDA   #$7F          initialiser A pour lecture
  BSR   SAUT          lecture bloc (secteur de boot)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)
  BSR   SAUT          lecture bloc (secteur sdplay)

*------------------------------------------------------
* PREPARATION PILE
*------------------------------------------------------
  PSHS  CC
  STS   BAK_S         sauvegarde pile

  ORCC  #$50          pas d'interupt pour ne pas poluer
  LDS   #STACK        nouvelle pille

  LDU   #FIN_BLOC     iteration 171 = fin de bloc
  PSHS  U

  LDB   #169          empilage 169 fois TRAME
  LDU   #TRAME
PREP_STACK
  PSHS  U
  DECB
  BNE   PREP_STACK

  LDX   #$0000        adresse ecran
  VAR   PATCH_ECR,-2
  JMP   DEB_BLOC      1 bloc = 170 * 3 + 2

*------------------------------------------------------
* Saut d'un bloc de la carte SD
*------------------------------------------------------
SAUT
  REPT  8,READ_BIT    lecture d'un octet
  CMPB  #$FE          comparaison avec $FE
  BNE   SAUT          attente debut secteur
  CLRB                initialisation compteur
SAUT1
  BSR   SAUT2         saut de 2 octets
  DECB                decrementation compteur
  BNE   SAUT1         pas termine?
SAUT2
  REPT  16,GET_BIT    saut du crc
  RTS                 retour

*------------------------------------------------------
* FIN DU PROGRAMME
*------------------------------------------------------
FIN
  LDS   #00000        restauration pile
  VAR   BAK_S,-2
  PULS  CC

* arret de la lecture
STOP
  LDU   #CMD12        adresse commande CMD12
  JSR   $A028         EXCMD = execution commande CMD12
  VAR   PATCH_FIN,-2
*  BCS   STOP

* nettoyage ecran
  LDU  PATCH_ECR
  LEAU 8000,U
  CLRB
  JSR  ECRAN1

* recommencer la lecture du fichier
  JMP   READ_VID

*------------------------------------------------------
* Erreur
*------------------------------------------------------
ERROR
  LDX   #ERRORMSG
  BSR   PUTS

ERROR2
  BSR   GETC          attente appui touche
  TSTB
  BEQ   ERROR2

RESET
  JMP   [$FFFE]       reset

PUTC
  TST   MACHINE
  LBPL  $E803
  SWI
  FCB   $82

GETC
  TST   MACHINE
  LBPL  $E806
  SWI
  FCB   $8A

  BSR   PUTC
PUTS
  LDB   ,X+
  BNE   PUTS-2
  RTS

*-----------------------------------------------------
* Mise a jour palette. B=index de la 1ere couleur
*-----------------------------------------------------
PALETTE
  PSHS  D,X,U
  LEAX  <$E7-$C0,X    X=$A7E7/$E7E7
  LSLB
  STB   -12,X         $A7DB/$E7DB
PALETTE1
  LDB   ,X            $A7E7/$E7E7
  BPL   PALETTE1
PALETTE2
  LDB   ,X            $A7E7/$E7E7
  BMI   PALETTE2
  LDD   #250
PALETTE3
  SUBD  #1
  BNE   PALETTE3
  LDU   #PALDATA
PALETTE4
  PULU  D
  STB   -13,X         $A7DA/$E7DA
  STA   -13,X
  CMPU  #PALDATA+32
  BNE   PALETTE4
  PULS  D,X,U,PC

*------------------------------------------------------
* Ecran special BM59 MO6/TO8/TO9= uniquement
*------------------------------------------------------
  IFEQ  MODE-MODE_BM59  
ECRAN_BM59
  LDB   MACHINE
  CMPB  #MACH_MO5
  BEQ   ERROR         mauvaise machine
  CMPB  #MACH_TO8
  BCS   ERROR         mauvaise machine
  LDD   #$5900
  BSR   PALETTE  
  BSR   TOUR
  STA   $1C,X
  BRA   FILL_FORME
  ENDC

*------------------------------------------------------
* Ecran 80x200 MO6/TO8/TO9 uniquement
*------------------------------------------------------
  IFEQ  MODE-MODE_PAL
ECRAN_PAL
  LDB   MACHINE
  CMPB  #MACH_MO5
  BEQ   ERROR         mauvaise machine
  CMPB  #MACH_TO8
  BCS   ERROR         mauvaise machine
  LSLB
  LDD   #$2008
  BCC   *+5
  LDD   #$0000        MO6
  BSR   PALETTE  
  STA   $1C,X
  BSR   TOUR
  CLRB
  BSR   FILL_FOND
  LDB   #$F0
  BSR   FILL_FORME
  JMP   FOND
  ENDC

*-----------------------------------------------------
* Couleur de tour (dans B)
*-----------------------------------------------------
TOUR
  PSHS B
  LDB  MACHINE
  CMPB #MACH_MO5
  BEQ  TOUR_MO5
  BCC  TOUR_MO6
  CMPB #MACH_TO9
  BCS  TOUR_TO770
  PULS B
  STB  >$E7DD
  RTS
TOUR_MO6
  PULS B
  STB  >$A7DD
  RTS
TOUR_MO5
  LDB  ,S
  LSLB
  ANDB #%00011110
  STB  ,-S
  LDB  #%11100001
  ANDB >$A7C0
  ORB  ,S+
  STB  >$A7C0
  PULS B,PC
TOUR_TO770
  LDB  ,S
  LSLB
  SUBB #$10
  ROLB
  LSLB
  LSLB
  ANDB #%01110100
  STB  ,-S
  LDB  #%10001011
  ANDB >$E7C3
  ORB  ,S+
  STB  >$E7C3
  PULS B,PC
  
*------------------------------------------------------
* Ecran monochrome
*------------------------------------------------------
  IFEQ  MODE-MODE_MONO
ECRAN_MONO
  LDD   #$7F00
  ANDA  MACHINE
  CMPA  #MACH_TO8
  BCS   ECRAN_MONO_GEN1
  BSR   PALETTE      reset palette et mode gfx
  STB   $1C,X        pour les machine gen2
ECRAN_MONO_GEN1
  LDB   #$0F
  ANDB  COLOR
  BSR   TOUR
  LDA   #$11
  MUL
  BSR   FILL_FOND_CV
  CLRB
  BSR   FILL_FORME
  LDB   COLOR
  BSR   FILL_FOND_CV
  BRA   FORME
  ENDC

*------------------------------------------------------
* Une ligne R une ligne G une ligne B
*------------------------------------------------------
  IFEQ  MODE-MODE_RGB
ECRAN_RGB
  PSHS  D,X,Y,U
  LDD   #$7F00
  ANDA  MACHINE
  CMPA  #MACH_TO8
  BCS   ECRAN_RGB_GEN1
  BSR   PALETTE      reset palette et mode gfx
  STB   $1C,X        pour les machine gen2
ECRAN_RGB_GEN1
  BSR   TOUR
  BSR   FILL_FOND_CV
  CLRB 
  BSR   FILL_FORME
  BSR   FOND
  LEAU  40,U
  LDB   #$40          bleu
  BSR   ECRAN31      
  LDB   #$20          vert
  BSR   ECRAN31
  LDB   #$10          rouge
  BSR   ECRAN31
  PULS  D,X,Y,U
  BRA   FORME
ECRAN31
  JSR   COLCONV
  TFR   B,A
  TFR   D,Y           Y=D="val" "val"
  LEAX  ,Y            X=Y=D="val" "val"
  LDA   #67           ca deborde un peu
ECRAN32
  PSHU  B,X,Y         ecrit une ligne
  PSHU  B,X,Y         (5*8) avec "val"
  PSHU  B,X,Y
  PSHU  B,X,Y
  PSHU  B,X,Y
  PSHU  B,X,Y
  PSHU  B,X,Y
  PSHU  B,X,Y
  LEAU  -2*40,U       remontee de 3 lignes
  DECA                repete 66 fois
  BNE   ECRAN32
  LEAU  8000,U
  RTS
  ENDC
  
*------------------------------------------------------
* Rempli l'ecran fond avec B
*------------------------------------------------------
FILL_FOND_CV
  BSR   COLCONV
FILL_FOND
  BSR   FOND
  BRA   ECRAN1
  
*------------------------------------------------------
* Remplie l'ecran forme avec B
*------------------------------------------------------
FILL_FORME
  BSR   FORME
* BRA   ECRAN1

*------------------------------------------------------
* Initialise la memoire video avec la valeur de B
* U=fin memoire video $1F40 ou $5F40
* prends 13.5ms = 68% d'un VBL
*------------------------------------------------------
ECRAN1
  PSHS  CC,D,DP,X,Y,U
  STS   ECRAN12
  LDA   2,S
  TFR   B,DP
  TFR   D,X           
  LEAY  ,X
  LDA   #100
  ORCC  #$50
  LEAS  ,X
ECRAN11
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  PSHU  B,DP,X,Y,S
  DECA
  BNE   ECRAN11
  LDS   #0
  VAR   ECRAN12,-2
  PULS  CC,D,DP,X,Y,U,PC
  
*-----------------------------------------------------
* Passage en memoire fond
*-----------------------------------------------------
FOND
  PSHS B                          
  LDB  #$FE
  CMPB MACHINE                                     (5)
  BPL  FOND_MO                                     (3)
  ANDB >$E7C3                                      (5)
  STB  >$E7C3                                      (5)
  PULS B,PC                                        (8)
FOND_MO
  ANDB >$A7C0                                      (5)
  STB  >$A7C0                                      (5)
  PULS B,PC                                        (8)

*-----------------------------------------------------
* Passage en memoire forme         
*-----------------------------------------------------
FORME
  PSHS B                          
  LDB  #$81                                        (2)
  CMPB  MACHINE                                    (5)
  BCS  FORME_MO                                    (3)
  ORB  >$E7C3   b7=1 sans importance (lect LEP)    (5)
  STB  >$E7C3                                      (5)
  PULS B,PC                                        (8)
FORME_MO
  ORB  >$A7C0   b7=1 sans importance (lect LEP)    (5)
  STB  >$A7C0                                      (5)
  PULS B,PC                                        (8)
  
*------------------------------------------------------
* Conversion couleur MO5->TO7
* Param B = $fF = fond/Forme
*------------------------------------------------------
COLCONV
  PSHS  D
  LDA   MACHINE      deviendra CMPA #nn sur TO
  BMI   COLCONV2
  LDA   1,S
  ANDA  #$F0
  LSRA
  STA   1,S  
  ORB   #$70
  ADDB  #$08
  ANDB  #$87
  ORB   1,S
  EORB  #%11000000    inversion bit pastel
  STB   1,S
COLCONV2
  PULS  D,PC
  
*-----------------------------------------------------
* Trame de deplacement 8 bits + 1 octet
* s6 0 1 | DD DD DD DD | VV VV VV VV             (114)
*-----------------------------------------------------
TRAME_01
  REPT  8,READ_BIT    lecture deplacement         (48)
  LEAX  3,X                                        (5)
  ABX                                              (3)
  REPT  8,READ_BIT    lecture video               (48)
  STB   -1,X                                       (5)
  RTS                                              (5)

*-----------------------------------------------------
* Attent un debut de bloc                         (53)
*-----------------------------------------------------
DEB_BLOC
  REPT  8,READ_BIT    lecture octet               (48)
  CMPB  #$FE          test debut bloc              (2)
  BNE   DEB_BLOC      attente debut de bloc        (3)

*-----------------------------------------------------
* TRAITE UNE TRAME DE 3 OCTETS            (54+114=168)
*-----------------------------------------------------
TRAME
  REPT  6,READ_BIT    lecture donnee son          (36)
  STB   <$CD          joue echantillon             (4)

  GET_BIT             lecture bit de position      (4)
  BCS   TRAME_1X      trame de position            (3)
  GET_BIT             lecture bit de deplacement   (4)
  BCS   TRAME_01      trame de deplacement         (3)

*-----------------------------------------------------
* Trame de video 4 pixels (P1 P2 P3 P4)
* s6 0 0 | VV VV VV VV | VV VV VV VV             (114)
*-----------------------------------------------------
TRAME_00
  REPT  8,READ_BIT    lecture video               (48)
  STB   ,X+                                        (6)
  REPT  7,READ_BIT    lecture video               (42)
  CMPA  >$A7BF        lecture bit                  (5)
  VAR   PATCH_CYC,-2
  ROLB                mise a jour B                (2)
  STB   ,X+                                        (6)
  RTS                                              (5)

TRAME_1X
  GET_BIT
  BCS   TRAME_11

*-----------------------------------------------------
* Trame de video 4+2 pixels (P1 P2 -- -- P3 P4)
* s6 1 0 | VV VV VV VV | VV VV VV VV             (114)
*-----------------------------------------------------
TRAME_10
  REPT  8,READ_BIT    lecture video               (48)
  STB   ,X++                                       (7)
  REPT  8,READ_BIT    lecture video               (48)
  STB   ,X+                                        (6)
  RTS                                              (5)

*-----------------------------------------------------
* Trame complexe
* s6 1 1 | XX XX XX XX | XX XX XX XX             (114)
*-----------------------------------------------------
TRAME_11
  GET_BIT                                          (4)
  BCS   TRAME_11_1                                 (3)

*-----------------------------------------------------
* Trame de CP4
* s6 1 1 | 0X XX XX XX | PP PP PP PP             (114)
*-----------------------------------------------------
TRAME_CP4
  REPT  7,GET_BIT                                 (28)
  REPT  8,READ_BIT                                (48)
* budget = 31
  STB   ,X                                         (4)
  STB   1,X                                        (5)
  STB   2,X                                        (5)
  STB   3,X                                        (5)
  LEAX  4,X                                        (5)
  NOP                                              (2)
  RTS                                              (5)

TRAME_11_1
  GET_BIT                                          (4)
  BCS   TRAME_11_11                                (3)

*-----------------------------------------------------
* Trame de position
* s6 1 1 | 10 XP PP PP | PP PP PP PP             (114)
*-----------------------------------------------------
TRAME_11_10
* budget = 100
  GET_BIT                                          (4)
  LDB   #$00          to/mo                        (2)
  VAR   PATCH_POS,-1
  REPT  5,READ_BIT    lecture bits poids fort     (30)
  STB   <POS,PCR      debut nouvelle addr video    (5)
  LDX   #$0000        chargement poids fort        (3)
  VAR   POS,-2
  REPT  8,READ_BIT    lecture bits poids faible   (48)
  ABX                 ajout poids faible           (3)
  RTS                 nouvelle trame               (5)

TRAME_11_11
  GET_BIT                                          (4)
  BCS   TRAME_11_111                               (3)

*-----------------------------------------------------
* Trame LZ-40,8,2
* s6 1 1 | 11 0X XX XX | XX XX XX XX             (114)
*-----------------------------------------------------
TRAME_LZ_2_8_2
